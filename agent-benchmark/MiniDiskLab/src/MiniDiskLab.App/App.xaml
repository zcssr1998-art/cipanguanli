<Application x:Class="MiniDiskLab.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- ============================================================
         主题资源（浅色 / 深色）由 ThemeManager 在运行时填充。
         这里只声明键名，避免设计器报错。
         ============================================================ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD8DEE6" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF1F2430" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5C6570" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2F6FED" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#FFEEF2F7" />

    <!-- 通用控件样式 -->
    <Style TargetType="TextBlock" x:Key="FieldLabel">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style TargetType="TextBox" x:Key="InputBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style TargetType="ComboBox" x:Key="UnitBox">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style TargetType="Button" x:Key="ActionButton">
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="Button" x:Key="PlainButton">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

  </Application.Resources>
</Application>
